# Prism backend configuration.
# Copy to .env and adjust values. Never commit the real .env file.

PRISM_APP_NAME=Prism
PRISM_ENVIRONMENT=development
# JSON array of browser origins allowed to call the API.
PRISM_CORS_ORIGINS=["http://localhost:3000"]
PRISM_MAX_UPLOAD_BYTES=10485760
PRISM_CHUNK_SIZE=1000
PRISM_CHUNK_OVERLAP=150
PRISM_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PRISM_EMBEDDING_BATCH_SIZE=32
PRISM_DEFAULT_TOP_K=5

# Database (Milestone 4). Use SQLite for a zero-dependency local tryout:
#   PRISM_DATABASE_URL=sqlite+pysqlite:///./prism.db
PRISM_DATABASE_URL=postgresql+psycopg://prism:prism@localhost:5432/prism

# API keys mapped to owner ids (JSON object). Every document/search request
# must send one of these keys in the X-API-Key header.
PRISM_API_KEYS={"dev-key":"dev-owner"}

# Create tables automatically on startup (dev convenience; use
# `alembic upgrade head` for the real migration workflow). Default true.
PRISM_AUTO_CREATE_SCHEMA=true

# Answer generation (Milestone 5). Any OpenAI-compatible /chat/completions
# endpoint works: OpenAI, Ollama (http://localhost:11434/v1), vLLM, LM Studio.
# Leave PRISM_LLM_BASE_URL empty to disable answers (POST /answer returns 503).
PRISM_LLM_BASE_URL=
PRISM_LLM_API_KEY=
PRISM_LLM_MODEL=gpt-4o-mini
PRISM_LLM_MAX_TOKENS=512
PRISM_LLM_TEMPERATURE=0.0
PRISM_LLM_TIMEOUT_SECONDS=60.0
# Optional token pricing used only for evaluation cost estimates (USD per 1M
# tokens). Leave at 0 to report "not configured" instead of a cost.
PRISM_LLM_INPUT_COST_PER_1M=0
PRISM_LLM_OUTPUT_COST_PER_1M=0

# Evaluation lab (Milestone 6). Reports are written as JSON and scoped to the
# owner id. This directory should be a mounted volume in Docker.
PRISM_EVALUATION_RESULTS_DIR=benchmarks/results
PRISM_EVALUATION_MAX_CONFIGURATIONS=8

# Docker Compose only (ignored by the API settings).
POSTGRES_PASSWORD=prism
PRISM_PUBLIC_API_URL=http://localhost:8000
